{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────────╮"
    },
    {
      "type": "title",
      "key": "│  user    {#keys}│",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "│ 󰇅 hname   {#keys}│",
      "format": "{host-name}"
    },
    {
      "type": "command",
      "key": "│ 󱦟 os age  {#keys}│",
      "keyColor": "magenta",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
    },
    {
      "type": "uptime",
      "key": "│ 󰅐 uptime  {#keys}│"
    },
    {
      "type": "os",
      "key": "│ {icon} distro  {#keys}│"
    },
    {
      "type": "kernel",
      "key": "│  kernel  {#keys}│"
    },
    {
      "type": "wm",
      "key": "│  wm      {#keys}│"
    },
    {
      "type": "de",
      "key": "│ 󰇄 desktop {#keys}│"
    },
    {
      "type": "terminal",
      "key": "│  term    {#keys}│"
    },
    {
      "type": "shell",
      "key": "│  shell   {#keys}│"
    },
    {
      "type": "cpu",
      "key": "│ 󰍛 cpu     {#keys}│",
      "showPeCoreCount": true
    },
    {
      "type": "disk",
      "key": "│ 󰉉 root    {#keys}│",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": "│ 󰉉 home    {#keys}│",
      "folders": "/home"
    },
    {
      "type": "disk",
      "key": "│ 󰉉 media   {#keys}│",
      "folders": "/media"
    },
    {
      "type": "memory",
      "key": "│  memory  {#keys}│"
    },
    {
      "type": "custom",
      "key": "├───────────┤"
    },
    {
      "type": "colors",
      "key": "│  colors  {#keys}│",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "key": "╰───────────╯"
    }
  ]
}
